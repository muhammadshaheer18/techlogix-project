{
  "name": "nav-bar",
  "version": "1.0.0",
  "jetVersion": "^14.0.0",
  "displayName": "Navigation Bar",
  "description": "Step-based navigation bar component",
  "properties": {
    "data": {
      "type": "object",
      "description": "Navigation data provider"
    },
    "selection": {
      "type": "string",
      "description": "Currently selected path",
      "writeback": true
    },
    "currentStep": {
      "type": "string",
      "description": "Current step path",
      "writeback": true
    },
    "completedSteps": {
      "type": "array",
      "description": "Array of completed step paths",
      "writeback": true
    },
    "showNavigation": {
      "type": "boolean",
      "description": "Whether to show navigation"
    }
  }
}